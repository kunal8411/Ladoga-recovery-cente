# Copy this file to .env.local and fill in the values.
# On Netlify, add the same variables under Site configuration -> Environment variables.

# --- Clerk (https://dashboard.clerk.com -> API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- MongoDB (Atlas -> Connect -> Drivers) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=recovery_shield

# --- App ---
# Public URL of the deployed site, used on the Device Setup page (e.g. https://recovery-shield.netlify.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# iCloud link of the shared "Recovery Shield Sync" Shortcut (shows an install QR on /device-setup)
NEXT_PUBLIC_SHORTCUT_URL=

# Comma-separated staff emails with the admin role (can change alert rules, seed demo data).
# Leave empty to make every signed-in staff member an admin (handy for the prototype).
ADMIN_EMAILS=

# Shared secret for the scheduled connectivity check: GET /api/cron/connectivity?secret=...
CRON_SECRET=change-me

# Map center used for synthetic demo patients (defaults to Austin, TX)
DEMO_CENTER_LAT=30.2672
DEMO_CENTER_LNG=-97.7431
